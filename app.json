{
  "expo": {
    "name": "weather-mobile-app",
    "slug": "weather-mobile-app",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/sun-light-mode.png",
    "scheme": "weathermobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/sun-light-mode.png",
        "dark": "./assets/images/sun-dark-mode.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141B29",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sun-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/sun-light-mode.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#11192A",
            "image": "./assets/images/sun-dark-mode.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Weather Mobile App to use your location to show nearby weather."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
